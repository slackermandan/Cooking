---
layout: null
---
{% assign entries = site.pages | where: "entry", true | sort: "date" %}
{% assign pinned = entries | where: "pinned", true %}
{% assign unpinned = entries | where_exp: "p", "p.pinned != true" %}
{% assign entries = pinned | concat: unpinned %}[{% for p in entries %}
  {"title": {{ p.title | jsonify }}, "url": {{ p.url | relative_url | jsonify }}, "date": {{ p.date | date: "%Y-%m-%d" | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}
]
